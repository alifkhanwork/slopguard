{
  "name": "@siliconvalleyglobal/slopguard",
  "version": "0.1.0",
  "description": "TypeScript bindings and agent-permit integration for SlopGuard slopsquatting defence",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./integrations/agent-permit": {
      "types": "./dist/agent_permit.d.ts",
      "import": "./dist/agent_permit.mjs",
      "require": "./dist/agent_permit.js"
    }
  },
  "bin": {
    "slopguard": "bin/slopguard.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "pack:dry": "npm pack --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alifkhanwork/slopguard.git"
  },
  "homepage": "https://github.com/alifkhanwork/slopguard#readme",
  "bugs": {
    "url": "https://github.com/alifkhanwork/slopguard/issues"
  },
  "keywords": [
    "slopguard",
    "slopsquatting",
    "slop-squatting",
    "supply-chain-security",
    "supply-chain-attack",
    "malicious-package-detector",
    "malicious-npm-packages",
    "npm-security",
    "pypi-security",
    "package-verification",
    "package-scanner",
    "dependency-security",
    "dependency-scanner",
    "typosquatting",
    "ai-hallucination",
    "hallucinated-packages",
    "llm-security",
    "ai-security",
    "install-time-scanner",
    "pip-install",
    "npm-install",
    "vulnerability-scanner",
    "sast",
    "devsecops",
    "ai-agent-security",
    "ai-coding-assistant",
    "developer-tools",
    "claude-code",
    "claude",
    "anthropic",
    "codex",
    "openai-codex",
    "gemini",
    "gemini-cli",
    "antigravity",
    "cursor",
    "cline",
    "windsurf",
    "github-copilot",
    "agent-permit"
  ],
  "author": "SVG Security",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
